# ============================================================
# SkyMind Backend — Environment Variables
# Copy to .env and fill in real values.
# NOTE: Amadeus API removed — no flight API keys needed.
# ============================================================

# ── App ───────────────────────────────────────────────────
SECRET_KEY=change-me-with-a-long-random-string
DEBUG=false

# ── Database ──────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...YOUR_SERVICE_ROLE_KEY...
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ── Email (Gmail SMTP) ────────────────────────────────────
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=SkyMind Flights
EMAIL_REPLY_TO=support@skymind.app

# ── SMS / Notifications ───────────────────────────────────
FAST2SMS_API_KEY=YOUR_FAST2SMS_KEY

# ── Twilio ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── CORS ──────────────────────────────────────────────────
# SKYMIND_ENV is `development` unless set to exactly `production`. In development
# any loopback origin is accepted on any port, so `npm run dev` works whichever
# port it lands on. In production only the origins listed below are accepted, and
# an empty CORS_ORIGINS there refuses every browser request — the API logs a
# warning at startup if that happens.
SKYMIND_ENV=production
CORS_ORIGINS=https://skymind.vercel.app,https://www.skymind.app

# ── ML ────────────────────────────────────────────────────
MODEL_PATH=./ml/models
GOOGLE_FLIGHTS_MCP_PATH=

# ── Live flight transport (MCP) ────────────────────────────
# Retry policy for backend/services/flight_data_service.py. Defaults shown.
MCP_MAX_RETRIES=3
MCP_RETRY_BACKOFF=1.0
MCP_TIMEOUT=30
# Chrome binary the Puppeteer providers launch. Leave blank to use the bundled
# Chromium that `npm install` downloads.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true

# ── FX rates ──────────────────────────────────────────────
# Only set these if you need cross-currency fares. There is deliberately no
# built-in default: an unset rate means the fare is returned in the currency the
# provider quoted, rather than converted at a hardcoded guess. Format is
# FX_<FROM>_<TO> = units of <TO> per 1 <FROM>.
FX_USD_INR=
